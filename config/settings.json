{
  "render": {
    "width": 1280,
    "height": 720,
    "fps": 60
  },
  "operator_screen": {
    "preview_width": 640,
    "preview_height": 360,
    "pause_preview_when_idle": true,
    "take_on_next_bar": true
  },
  "bpm_bands": [
    { "name": "organic", "min_bpm": 0, "max_bpm": 100, "shader": "scene_organic.glsl" },
    { "name": "flow", "min_bpm": 100, "max_bpm": 125, "shader": "scene_flow.glsl" },
    { "name": "grid", "min_bpm": 125, "max_bpm": 135, "shader": "scene_grid.glsl" },
    { "name": "shards", "min_bpm": 135, "max_bpm": 999, "shader": "scene_shards.glsl" }
  ],
  "scene_change": {
    "crossfade_bars": 2,
    "change_only_on_bar": true
  },
  "safety": {
    "max_flashes_per_second": 3
  },
  "palettes": [
    { "name": "placeholder_ember", "colors": ["#14070f", "#6a1b4d", "#e2522f", "#f6c453"] },
    { "name": "placeholder_tide", "colors": ["#04121c", "#0e4d64", "#30b0c7", "#d8f3f0"] },
    { "name": "placeholder_aura", "colors": ["#0d0a1f", "#4b2a8a", "#c56cf0", "#ffe3fa"] }
  ],
  "photo_deck": {
    "folder": "images",
    "extensions": ["jpg", "jpeg", "png", "tif", "tiff"],
    "auto_advance_bars": 16,
    "recolor_to_palette": true,
    "crystal_warp_amount": 0.3,
    "ripple_amount": 0.2,
    "zoom_pulse_amount": 0.04,
    "glitch_on_drop": true
  },
  "light_modes": {
    "default": "scene",
    "modes": ["scene", "hanging", "kaleidoscope"],
    "switch_on_bar": true,
    "crossfade_bars": 1,
    "hanging": {
      "dispersion": 0.02,
      "caustic_strength": 1.0,
      "sway_amount": 0.15,
      "sway_damping": 0.9,
      "sway_kick_on_beat": true
    },
    "kaleidoscope": {
      "wedges": 6,
      "wedges_min": 3,
      "wedges_max": 12,
      "beat_zoom": 0.05,
      "rotation_gain": 1.0
    }
  },
  "image_source": {
    "mode": "auto",
    "options": ["auto", "virtual", "camera"],
    "camera_lost_after_sec": 2
  },
  "audio": {
    "device": "Stereo Mix",
    "bands_hz": {
      "bass": [20, 150],
      "mids": [150, 2000],
      "treble": [4000, 16000]
    },
    "filter_rolloff_db": 24,
    "band_gain": {
      "bass": 2,
      "mids": 2.5,
      "treble": 5
    },
    "attack_sec": 0.05,
    "release_sec": 0.3,
    "drop_breakdown_ratio": 0.35,
    "drop_breakdown_sec": 4,
    "drop_return_ratio": 0.7,
    "drop_min_bass": 0.05,
    "drop_reference_halflife_sec": 60,
    "drop_min_music_sec": 30,
    "drop_silence_reset_sec": 3,
    "drop_min_level": 0.03,
    "drop_jump_ratio": 2,
    "drop_jump_min_level": 0.3,
    "drop_jump_lag_sec": 1,
    "drop_flag_hold_sec": 0.25,
    "drop_cooldown_bars": 8,
    "drop_manual_key": "j",
    "drop_manual_min_gap_sec": 0.5,
    "fallback_bpm": 128
  },
  "virtual_crystal": {
    "turn_bars": 8,
    "gem_size": 0.85,
    "gem_tilt_deg": 28,
    "ior": 1.55,
    "refraction": 0.45,
    "dispersion": 0.05,
    "bass_breathe": 0.25,
    "treble_sparkle": 1.5,
    "mids_drift": 0.3,
    "facet_base": 0.7,
    "facet_contrast": 0.9,
    "edge_glow": 0.3,
    "glint_gain": 1.4,
    "background_dim": 0.45,
    "halo_shadow": 0.8,
    "beat_pulse": 0.06,
    "beat_kick_release_sec": 0.18,
    "beat_twist_deg": 7,
    "sway_deg": 14,
    "sway_bars": 2,
    "move_change_bars": [2, 4, 4, 8],
    "move_glide_bars": 1,
    "move_spin_range": [0.5, 1.7],
    "move_spin_reverse_chance": 0.2,
    "move_sway_size_range": [0.5, 1.5],
    "move_sway_speed_range": [0.5, 1.5],
    "move_tilt_deg": 12,
    "move_roll_deg": 10,
    "motion_attack_sec": 0.15,
    "motion_release_sec": 1.5,
    "motion_floor_bass": 0.1,
    "motion_peak_halflife_sec": 60,
    "motion_full_at": 0.6,
    "idle_motion": 0.12,
    "idle_spin": 0.25,
    "punch_floor_level": 0.25,
    "punch_from": 0.35,
    "punch_full_at": 0.7,
    "shapes": ["brilliant", "quartz", "octahedron", "emerald"],
    "shape_change_interval_sec": 90,
    "shape_change_styles": ["morph", "shrink"],
    "morph_sec": 6,
    "shrink_out_sec": 2.5,
    "shrink_in_sec": 2.5,
    "shrink_distance": 1.0,
    "satellite_interval_sec": 12,
    "satellite_out_sec": 4,
    "satellite_float_sec": 48,
    "satellite_back_sec": 4,
    "camera_distance": 3,
    "camera_lens": 1.6,
    "picture_half_width": 0.889,
    "satellite_tile_px": 640,
    "dolphin_field_px": 512,
    "satellite_figures": ["laughing_face", "pill", "crystal"],
    "satellite_figure_size": 1.6,
    "satellite_pill_size": 0.75,
    "satellite_figure_turn_deg": 22,
    "satellite_figure_melt": 0.2,
    "satellite_figure_nod_deg": 12,
    "satellite_size": 0.24,
    "satellite_distance": 1.15,
    "satellite_orbit_bars": 3,
    "satellite_orbit_glide_sec": 1,
    "satellite_pulse_attack_sec": 0.06,
    "satellite_pulse_release_sec": 0.35,
    "satellite_beat_swell": 0.12,
    "satellite_beat_melt": 0.5,
    "satellite_move_ratio": 1.4,
    "satellite_orbit_tilt_deg": 40,
    "satellite_orbit_roll_deg": 60,
    "satellite_orbit_change_bars": [2, 4, 4, 8],
    "satellite_orbit_turn_bars": 1.5,
    "satellite_orbit_reverse_chance": 0.35,
    "satellite_middle_radius": 0.42,
    "satellite_middle_min_spin": 0.5,
    "satellite_bob": 0.06,
    "satellite_bob_sec": 3,
    "droplet_gem_interval_sec": 7.5,
    "droplet_smiley_interval_sec": 3.5,
    "droplet_pill_interval_sec": 6,
    "droplet_gem_reach": 0.9,
    "droplet_size_range": [0.075, 0.125],
    "droplet_speed": 0.3,
    "droplet_lift": 0.12,
    "droplet_max_at_once": 2,
    "droplet_min_gap_sec": 2.5,
    "droplet_emerge_sec_range": [1.5, 2.3],
    "droplet_emerge_stretch": 0.35,
    "droplet_settle_sec": 1.2,
    "droplet_clearance": 0.13,
    "droplet_behind": 0.3,
    "droplet_sway": 0.35,
    "droplet_sway_rate": 1.1,
    "droplet_ripple_rate": 1.6,
    "droplet_idle_flow": 0.35,
    "droplet_max_sec": 25,
    "explode_out_beats": 0.5,
    "explode_reform_beats": 4,
    "shard_spread": 1.3,
    "shard_size": 0.11,
    "shard_spin": 1.2
  },
  "tempo": {
    "prefer": "link",
    "link_lost_after_sec": 3,
    "audio_settle_sec": 10,
    "audio_lost_after_sec": 4,
    "audio_bpm_window_beats": 16,
    "audio_silence_level": 0.005,
    "audio_silence_after_sec": 0.5,
    "bpm_multiplier": 1.0,
    "beats_per_bar": 4,
    "tracker_single_model": true
  },
  "crystal": {
    "marker_hsv_min": [0.0, 0.5, 0.4],
    "marker_hsv_max": [0.08, 1.0, 1.0],
    "sparkle_threshold": 0.85,
    "spin_smoothing": 0.8
  },
  "gestures": {
    "hold_sec": 0.5,
    "palm_freeze_hold_sec": 2.0,
    "pinch_distance": 0.05
  },
  "led": {
    "serial_port": "COM3",
    "baud": 115200,
    "max_updates_per_sec": 30,
    "brightness": 0.6
  },
  "midi": {
    "device": "",
    "map": {
      "cc1": "intensity",
      "cc2": "led_brightness",
      "note36": "scene_next",
      "note37": "palette_next",
      "note38": "blackout",
      "note39": "light_mode_next",
      "note40": "image_source_next",
      "note41": "drop"
    }
  },
  "web": {
    "port": 9990,
    "pin": "change-me"
  }
}
